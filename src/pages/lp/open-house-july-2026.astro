---
import { getEntry } from "astro:content";
import LPLayout from "../../layouts/LPLayout.astro";
import ObjectionHero from "../../components/lp/ObjectionHero.astro";
import BlockRenderer from "../../components/lp/BlockRenderer.astro";

const lp = await getEntry("landing", "open-house-july-2026");
if (!lp) throw new Error("LP content missing");
const d = lp.data;
---
<LPLayout title={d.title} description={d.description} ctaLabel="RSVP — it's free" ctaHref="#rsvp" ctaTrigger="link" locationLine="301 A St SE, Washington, DC 20003">
  <ObjectionHero
    eyebrow={d.eyebrow}
    headline={d.heroHeadline}
    headlineHighlight={d.heroHeadlineHighlight}
    subhead={d.heroSubhead}
    photo={d.heroPhoto}
    alt={d.heroAlt}
    location={d.heroLocation}
    ctas={d.heroCTAs}
    sessions={d.sessions}
    sessionsLocation={d.sessionsLocation}
  />
  {d.blocks.map((b) => <BlockRenderer block={b} />)}
</LPLayout>
