---
// Notification-style cookie banner. Analytics are granted by default
// (set in BaseHead via Consent Mode v2). Banner is informational and shows
// once on first visit; user can dismiss or opt out. Choice persists in
// localStorage as `starling_cookie_consent` ("granted" | "denied").
// Footer link `[data-cookie-prefs]` re-opens the banner anytime.
---
<div
  id="cookie-consent"
  class="hidden fixed bottom-0 inset-x-0 z-40 bg-white border-t border-cetacean/10 shadow-[0_-4px_24px_rgba(12,22,61,0.06)]"
  role="dialog"
  aria-label="Cookie notice"
  aria-live="polite"
>
  <div class="max-w-[1100px] mx-auto px-6 lg:px-8 py-4 flex flex-col md:flex-row md:items-center gap-4">
    <p class="text-sm text-cetacean-70 leading-relaxed md:flex-1">
      We use a few analytics cookies to understand how families use our site.
      You can change your preferences anytime — see our
      <a href="/privacy" class="underline underline-offset-2 text-cetacean hover:text-pearly-deep">privacy policy</a>.
    </p>
    <div class="flex items-center gap-4 shrink-0">
      <button
        type="button"
        data-cookie-action="decline"
        class="text-sm text-cetacean-70 hover:text-cetacean underline underline-offset-2"
      >Opt out</button>
      <button
        type="button"
        data-cookie-action="accept"
        class="px-5 py-2 rounded-pill text-sm font-medium bg-cetacean text-seashell hover:bg-cetacean-90"
      >Got it</button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var KEY = "starling_cookie_consent";
    var banner = document.getElementById("cookie-consent");
    if (!banner) return;

    function applyConsent(value) {
      var granted = value === "granted";
      if (typeof window.gtag === "function") {
        window.gtag("consent", "update", {
          ad_storage: granted ? "granted" : "denied",
          ad_user_data: granted ? "granted" : "denied",
          ad_personalization: granted ? "granted" : "denied",
          analytics_storage: granted ? "granted" : "denied",
        });
      }
      if (typeof window.clarity === "function") {
        if (granted) window.clarity("consent");
        else window.clarity("consent", false);
      }
    }

    function setChoice(value) {
      try { localStorage.setItem(KEY, value); } catch (e) {}
      applyConsent(value);
      banner.classList.add("hidden");
    }

    var existing = null;
    try { existing = localStorage.getItem(KEY); } catch (e) {}

    if (existing === "denied") {
      // Honor a prior opt-out across visits.
      applyConsent("denied");
    } else if (existing !== "granted") {
      // First visit (or unknown value) — tracking is already on by default;
      // show the notice so the visitor can opt out if they prefer.
      banner.classList.remove("hidden");
    }

    banner.querySelectorAll("[data-cookie-action]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        var action = btn.getAttribute("data-cookie-action");
        setChoice(action === "accept" ? "granted" : "denied");
      });
    });

    document.addEventListener("click", function(e) {
      var target = e.target instanceof Element ? e.target.closest("[data-cookie-prefs]") : null;
      if (!target) return;
      e.preventDefault();
      banner.classList.remove("hidden");
    });
  })();
</script>
