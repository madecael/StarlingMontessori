---
// Slim, gentle cookie consent banner with Google Consent Mode v2 integration.
// Banner appears once; choice persists in localStorage as `starling_cookie_consent`
// (values: "granted" | "denied"). Footer link `[data-cookie-prefs]` re-opens it.
---
<div
  id="cookie-consent"
  class="hidden fixed bottom-0 inset-x-0 z-40 bg-white border-t border-cetacean/10 shadow-[0_-4px_24px_rgba(12,22,61,0.06)]"
  role="dialog"
  aria-label="Cookie preferences"
  aria-live="polite"
>
  <div class="max-w-[1100px] mx-auto px-6 lg:px-8 py-4 flex flex-col md:flex-row md:items-center gap-4">
    <p class="text-sm text-cetacean-70 leading-relaxed md:flex-1">
      We use a few analytics cookies to understand how families experience our site.
      You're welcome to decline — the site works the same either way.
      <a href="/privacy" class="underline underline-offset-2 text-cetacean hover:text-pearly-deep">Read our privacy policy</a>.
    </p>
    <div class="flex gap-2 shrink-0">
      <button
        type="button"
        data-cookie-action="decline"
        class="px-4 py-2 rounded-pill text-sm font-medium border border-cetacean/20 text-cetacean hover:bg-cetacean/5"
      >Decline</button>
      <button
        type="button"
        data-cookie-action="accept"
        class="px-4 py-2 rounded-pill text-sm font-medium bg-cetacean text-seashell hover:bg-cetacean-90"
      >Accept</button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var KEY = "starling_cookie_consent";
    var banner = document.getElementById("cookie-consent");
    if (!banner) return;

    function applyConsent(value) {
      var granted = value === "granted";
      if (typeof window.gtag === "function") {
        window.gtag("consent", "update", {
          ad_storage: granted ? "granted" : "denied",
          ad_user_data: granted ? "granted" : "denied",
          ad_personalization: granted ? "granted" : "denied",
          analytics_storage: granted ? "granted" : "denied",
        });
      }
      if (typeof window.clarity === "function") {
        if (granted) window.clarity("consent");
        else window.clarity("consent", false);
      }
    }

    function setChoice(value) {
      try { localStorage.setItem(KEY, value); } catch (e) {}
      applyConsent(value);
      banner.classList.add("hidden");
    }

    var existing = null;
    try { existing = localStorage.getItem(KEY); } catch (e) {}

    if (existing === "granted" || existing === "denied") {
      applyConsent(existing);
    } else {
      banner.classList.remove("hidden");
    }

    banner.querySelectorAll("[data-cookie-action]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        var action = btn.getAttribute("data-cookie-action");
        setChoice(action === "accept" ? "granted" : "denied");
      });
    });

    document.addEventListener("click", function(e) {
      var target = e.target instanceof Element ? e.target.closest("[data-cookie-prefs]") : null;
      if (!target) return;
      e.preventDefault();
      banner.classList.remove("hidden");
    });
  })();
</script>
