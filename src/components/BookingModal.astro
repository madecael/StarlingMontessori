---
import { getEntry } from "astro:content";
const settings = await getEntry("settings", "site");
const toddlerUrl = settings?.data.bookingUrlToddler;
const primaryUrl = settings?.data.bookingUrlPrimary;
const pathname = Astro.url.pathname;
const isPrimary = pathname.includes("primary");
const isToddler = pathname.includes("toddler");
const mode: "toddler" | "primary" | "choose" = isPrimary ? "primary" : isToddler ? "toddler" : "choose";
const hasAnyUrl = !!(toddlerUrl || primaryUrl);
---
{hasAnyUrl && (
  <dialog id="booking-modal" class="m-auto p-0 rounded-3xl shadow-lg w-[min(92vw,520px)] max-h-[90vh] overflow-y-auto backdrop:bg-cetacean/40 backdrop:backdrop-blur-sm bg-seashell">
    <div class="flex items-center justify-between px-6 py-4 border-b border-cetacean/10">
      <div class="eyebrow">SCHEDULE A TOUR</div>
      <button data-booking-close aria-label="Close" class="text-cetacean text-2xl leading-none px-3 py-1 hover:text-pearly-deep">×</button>
    </div>
    <div class="px-7 py-8">
      {mode === "toddler" && toddlerUrl && (
        <>
          <h2 class="text-2xl lg:text-[28px] font-light text-cetacean tracking-tightest leading-tight">Pick a time for your Toddler tour.</h2>
          <p class="text-sm text-cetacean-70 leading-relaxed mt-3">
            30-minute in-person tour with Fabienne at our Toddler classroom on Capitol Hill.
          </p>
          <button
            type="button"
            class="btn btn-pearly mt-6 w-full justify-center"
            data-event="booking_open_in_tab"
            data-calendly-open={toddlerUrl}
          >
            Open booking calendar →
          </button>
        </>
      )}
      {mode === "primary" && primaryUrl && (
        <>
          <h2 class="text-2xl lg:text-[28px] font-light text-cetacean tracking-tightest leading-tight">Pick a time for your Primary tour.</h2>
          <p class="text-sm text-cetacean-70 leading-relaxed mt-3">
            30-minute in-person tour of our new Primary classroom at Saint Mark Episcopal. Virtual option available if you're relocating.
          </p>
          <button
            type="button"
            class="btn btn-pearly mt-6 w-full justify-center"
            data-event="booking_open_in_tab"
            data-calendly-open={primaryUrl}
          >
            Open booking calendar →
          </button>
        </>
      )}
      {mode === "choose" && (
        <>
          <h2 class="text-2xl lg:text-[28px] font-light text-cetacean tracking-tightest leading-tight">Which program is your child considering?</h2>
          <p class="text-sm text-cetacean-70 leading-relaxed mt-3">
            Choose the tour that fits — we'll walk you through the right classroom.
          </p>
          <div class="grid gap-3 mt-6">
            {toddlerUrl && (
              <button
                type="button"
                class="btn btn-pearly justify-center text-center"
                data-event="booking_open_in_tab"
                data-calendly-open={toddlerUrl}
              >
                Toddler Tour · 16 months – 3 years
              </button>
            )}
            {primaryUrl && (
              <button
                type="button"
                class="btn btn-outline justify-center text-center"
                data-event="booking_open_in_tab"
                data-calendly-open={primaryUrl}
              >
                Primary Tour · 3 – 6 years (Aug 2026)
              </button>
            )}
          </div>
        </>
      )}
      <p id="booking-modal-hint" class="text-xs text-cetacean-70 mt-4 text-center">
        Booking calendar loads right here — no new tab.
      </p>
      <div id="calendly-embed-container" class="hidden mt-4"></div>
    </div>
  </dialog>
)}
<script>
  import { buildCalendlyUrl, mountInlineWidget } from "../lib/calendly-client";

  function resetBookingModal() {
    const modal = document.getElementById("booking-modal");
    const container = document.getElementById("calendly-embed-container");
    const hint = document.getElementById("booking-modal-hint");
    container?.classList.add("hidden");
    if (container) container.innerHTML = "";
    hint?.classList.remove("hidden");
    modal?.querySelectorAll<HTMLElement>("[data-calendly-open]").forEach((btn) => {
      btn.classList.remove("hidden");
    });
  }

  document.addEventListener("click", (e) => {
    const trigger = (e.target as HTMLElement).closest("[data-booking-trigger]");
    if (trigger) {
      const modal = document.getElementById("booking-modal") as HTMLDialogElement | null;
      if (modal) {
        e.preventDefault();
        modal.showModal();
        if (typeof (window as any).gtag === "function") {
          (window as any).gtag("event", "booking_modal_open");
        }
      }
      return;
    }
    const close = (e.target as HTMLElement).closest("[data-booking-close]");
    if (close) {
      const modal = document.getElementById("booking-modal") as HTMLDialogElement | null;
      modal?.close();
      return;
    }
    const calendlyOpen = (e.target as HTMLElement).closest("#booking-modal [data-calendly-open]");
    if (calendlyOpen) {
      const baseUrl = calendlyOpen.getAttribute("data-calendly-open");
      const container = document.getElementById("calendly-embed-container");
      const hint = document.getElementById("booking-modal-hint");
      const modal = document.getElementById("booking-modal") as HTMLDialogElement | null;
      if (!baseUrl || !container || !modal) return;
      modal.querySelectorAll<HTMLElement>("[data-calendly-open]").forEach((btn) => {
        btn.classList.add("hidden");
      });
      hint?.classList.add("hidden");
      container.classList.remove("hidden");
      mountInlineWidget(container, buildCalendlyUrl(baseUrl));
    }
  });
  const modal = document.getElementById("booking-modal") as HTMLDialogElement | null;
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) modal.close();
  });
  modal?.addEventListener("close", resetBookingModal);
</script>
