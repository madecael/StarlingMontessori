---
import { getEntry } from "astro:content";
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  fallbackTitle?: string;
  fallbackBody?: string;
}
const { eyebrow, title, subtitle, fallbackTitle, fallbackBody } = Astro.props;
const settings = await getEntry("settings", "site");
const openHouseUrl = settings?.data.bookingUrlOpenHouse;
---
<section id="rsvp" class="px-6 lg:px-8 py-16 max-w-[1240px] mx-auto">
  <div class="eyebrow">{eyebrow}</div>
  <h2 class="text-3xl lg:text-4xl font-light text-cetacean mt-2 mb-3 tracking-tightest">{title}</h2>
  {subtitle && <p class="text-base text-cetacean-70 mb-7 max-w-2xl leading-relaxed">{subtitle}</p>}
  {openHouseUrl ? (
    <div class="bg-white rounded-3xl p-8 lg:p-10 shadow-sm max-w-xl">
      <button
        type="button"
        id="calendly-booking-trigger"
        class="btn btn-pearly justify-center w-full"
        data-event="booking_open_in_tab"
        data-calendly-open={openHouseUrl}
      >
        RSVP — it's free
      </button>
      <p id="calendly-booking-hint" class="text-xs text-cetacean-70 mt-4 text-center">
        Booking calendar loads right here — no new tab.
      </p>
      <div id="calendly-embed-container-openhouse" class="hidden mt-4"></div>
    </div>
  ) : (
    <div class="bg-white rounded-3xl p-8 text-cetacean-70 max-w-xl">
      <div class="text-lg font-light text-cetacean mb-2">{fallbackTitle ?? "Booking is being set up."}</div>
      <p class="text-sm leading-relaxed">
        {fallbackBody ?? "We're configuring RSVPs for this open house. In the meantime, please email info@starlingmontessorischool.com and we'll save your spot."}
      </p>
    </div>
  )}
</section>
{openHouseUrl && (
  <script>
    import { buildCalendlyUrl, mountInlineWidget } from "../../lib/calendly-client";
    const trigger = document.getElementById("calendly-booking-trigger");
    const container = document.getElementById("calendly-embed-container-openhouse");
    const hint = document.getElementById("calendly-booking-hint");
    trigger?.addEventListener("click", () => {
      const baseUrl = trigger.getAttribute("data-calendly-open");
      if (!baseUrl || !container) return;
      trigger.classList.add("hidden");
      hint?.classList.add("hidden");
      container.classList.remove("hidden");
      mountInlineWidget(container, buildCalendlyUrl(baseUrl));
    });
  </script>
)}
