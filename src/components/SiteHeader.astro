---
import BrandWordmark from "./BrandWordmark.astro";
import { getEntry } from "astro:content";

interface Props { currentPath?: string; }
const { currentPath = "" } = Astro.props;
const settings = await getEntry("settings", "site");
const phone = settings?.data.phone;

type NavLeaf = { label: string; href: string };
type NavItem = { label: string; href?: string; children?: NavLeaf[] };

const nav: NavItem[] = [
  { label: "About", children: [
    { label: "About", href: "/about" },
    { label: "Careers", href: "/careers" },
  ]},
  { label: "The Method", href: "/montessori" },
  { label: "Programs", children: [
    { label: "Toddler Community", href: "/programs/toddler" },
    { label: "Primary Classroom", href: "/programs/primary" },
  ]},
  { label: "Admissions", children: [
    { label: "Admissions", href: "/admissions" },
    { label: "Tuition", href: "/tuition" },
    { label: "FAQ", href: "/faq" },
  ]},
  { label: "Visit", href: "/open-house" },
];

function isActive(item: NavItem): boolean {
  if (item.href) {
    if (item.href === "/") return currentPath === "/";
    return currentPath.startsWith(item.href);
  }
  return (item.children ?? []).some((c) => currentPath.startsWith(c.href));
}
---
<header class="sticky top-0 z-20 bg-seashell/85 backdrop-blur border-b border-cetacean/10">
  <div class="max-w-[1240px] mx-auto px-6 lg:px-8 py-4 flex items-center gap-6 lg:gap-8">
    <a href="/" class="flex items-center shrink-0">
      <BrandWordmark size="md" />
    </a>
    <nav class="hidden lg:flex gap-1 xl:gap-3 text-sm">
      {nav.map((item) => (
        item.children ? (
          <div class="relative group">
            <button
              type="button"
              class:list={[
                "px-2 xl:px-3 py-2 inline-flex items-center gap-1 rounded-lg",
                isActive(item) ? "text-pearly-deep font-semibold" : "text-cetacean hover:text-pearly-deep",
              ]}
              aria-haspopup="true"
            >
              {item.label}
              <svg class="w-3 h-3 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-opacity duration-150">
              <div class="bg-seashell border border-cetacean/10 rounded-2xl shadow-lg py-2 min-w-[220px]">
                {item.children.map((c) => (
                  <a
                    href={c.href}
                    class:list={[
                      "block px-4 py-2 text-sm whitespace-nowrap",
                      currentPath.startsWith(c.href) ? "text-pearly-deep font-semibold" : "text-cetacean hover:bg-cetacean/5 hover:text-pearly-deep",
                    ]}
                  >
                    {c.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href!}
            class:list={[
              "px-2 xl:px-3 py-2 rounded-lg",
              isActive(item) ? "text-pearly-deep font-semibold" : "text-cetacean hover:text-pearly-deep",
            ]}
          >
            {item.label}
          </a>
        )
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-3">
      <a href={`tel:${phone?.replace(/[^0-9+]/g, "")}`} class="hidden md:inline text-sm text-cetacean" data-event="phone_click">📞 {phone}</a>
      <a href="/open-house" class="btn btn-primary text-[13px] px-4 py-2" data-booking-trigger>Schedule a tour</a>
      <button id="menu-toggle" class="lg:hidden btn btn-outline text-[13px] px-3 py-2" aria-label="Toggle navigation">☰</button>
    </div>
  </div>
  <div id="mobile-menu" class="lg:hidden hidden border-t border-cetacean/10 bg-seashell">
    <div class="px-6 py-4 flex flex-col gap-1">
      {nav.map((item) => (
        item.children ? (
          <details class="group/details">
            <summary class:list={[
              "py-2 cursor-pointer list-none flex justify-between items-center",
              isActive(item) ? "text-pearly-deep font-semibold" : "text-cetacean text-base",
            ]}>
              <span>{item.label}</span>
              <svg class="w-4 h-4 transition-transform group-open/details:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="flex flex-col gap-2.5 ml-4 mt-1 mb-2">
              {item.children.map((c) => (
                <a
                  href={c.href}
                  class:list={[
                    "text-sm",
                    currentPath.startsWith(c.href) ? "text-pearly-deep font-semibold" : "text-cetacean",
                  ]}
                >
                  {c.label}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={item.href!}
            class:list={[
              "py-2",
              isActive(item) ? "text-pearly-deep font-semibold" : "text-cetacean text-base",
            ]}
          >
            {item.label}
          </a>
        )
      ))}
    </div>
  </div>
  <script>
    const t = document.getElementById("menu-toggle");
    const m = document.getElementById("mobile-menu");
    t?.addEventListener("click", () => m?.classList.toggle("hidden"));
  </script>
</header>
